class Solution {

    public int countOrders(int n) {

        long MOD = 1000000007;
        long ans = 1;

        for (int i = 1; i <= n; i++) {

            ans = ans * i % MOD;
            ans = ans * (2L * i - 1) % MOD;
        }

        return (int) ans;
    }
}


