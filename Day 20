class Solution {
    public boolean mergeTriplets(int[][] triplets, int[] target) {

        boolean x = false;
        boolean y = false;
        boolean z = false;

        for (int[] t : triplets) {

            // This triplet can never be used
            if (t[0] > target[0] ||
                t[1] > target[1] ||
                t[2] > target[2]) {
                continue;
            }

            // Check which target values this triplet can provide
            if (t[0] == target[0]) {
                x = true;
            }

            if (t[1] == target[1]) {
                y = true;
            }

            if (t[2] == target[2]) {
                z = true;
            }
        }

        return x && y && z;
    }
}


