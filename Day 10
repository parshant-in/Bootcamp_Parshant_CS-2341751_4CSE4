Problem-98
class Solution {
    public boolean isValidBST(TreeNode root) {
        if(root==null){
            return true;
        }
        if(root.left==null && root.right==null){
            return true;
        }
        return isIntervalBST(root.left,Long.MIN_VALUE,root.val) && isIntervalBST(root.right,(long) root.val,(long) Long.MAX_VALUE);
    }

    public boolean isIntervalBST(TreeNode node, long min, long max){
        if(node==null){
            return true;
        }
        if(node.val<=min || node.val>=max){
            return false;
        }
        return isIntervalBST(node.left,min,(long) node.val) && isIntervalBST(node.right,(long) node.val,max);
    }
}

Problem-230
class Solution {
    
    ArrayList<Integer> al = new ArrayList<>();
    
    void helper(TreeNode root) {
        
        if(root == null) return ;
        
        helper(root.left);
        al.add(root.val);
        helper(root.right);
        
    }
    
    
    public int kthSmallest(TreeNode root, int k) {
        
        helper( root);
        
        return al.get(k-1);
        
        
    }
}

Problem-235
class Solution {
    public TreeNode lowestCommonAncestor(TreeNode root, TreeNode p, TreeNode q) {

        while (root != null) {

            if (p.val < root.val && q.val < root.val) {
                root = root.left;
            }
            else if (p.val > root.val && q.val > root.val) {
                root = root.right;
            }
            else {
                return root;
            }
        }

        return null;
    }
}
